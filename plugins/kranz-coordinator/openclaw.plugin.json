{
  "id": "kranz-coordinator",
  "name": "Kranz Coordinator",
  "description": "Run and inspect the durable event-driven NTC research controller.",
  "version": "0.9.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "stateRoot": {
        "type": "string",
        "description": "Shared NTC runtime-state root. Relative paths resolve from the shared workspace."
      },
      "artifactRoot": {
        "type": "string",
        "description": "Durable research-artifact root. Defaults to <stateRoot>/artifacts."
      },
      "ownerSessionKey": {
        "type": "string",
        "const": "agent:kranz-coordinator:main",
        "description": "Stable TaskFlow owner shared by Kranz main and scheduled callers."
      },
      "wakeSessionKey": {
        "type": "string",
        "enum": [
          "agent:kranz-coordinator:main",
          "agent:ntc-controller:main"
        ],
        "description": "Stable admitted controller session that receives completion and deadline wakes."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "kranz_flow_start",
      "kranz_flow_link_task",
      "kranz_flow_checkpoint",
      "kranz_flow_set_run_scope",
      "kranz_flow_tick",
      "kranz_flow_execute_pending_action",
      "kranz_flow_sync_monitor",
      "kranz_flow_status"
    ]
  }
}
