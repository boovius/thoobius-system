{
  "id": "kranz-coordinator",
  "name": "Kranz Coordinator",
  "description": "Run and inspect the durable Kranz NTC research controller.",
  "version": "0.4.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "stateRoot": {
        "type": "string",
        "description": "Shared NTC runtime-state root. Relative paths resolve from the shared workspace."
      },
      "artifactRoot": {
        "type": "string",
        "description": "Durable research-artifact root. Defaults to <stateRoot>/artifacts."
      }
    },
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "kranz_flow_start",
      "kranz_flow_link_task",
      "kranz_flow_checkpoint",
      "kranz_flow_tick",
      "kranz_flow_status"
    ]
  }
}
